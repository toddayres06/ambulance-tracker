generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String?    
  role       Role
  station    String    
  active     Boolean    @default(true)
  shiftStart DateTime?
  shiftEnd   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  schedules  Schedule[]

  shiftAssignments ShiftAssignment[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  EMT
  DISPATCHER
  ADMIN
}

model ShiftAssignment {
  id        Int       @id @default(autoincrement())
  date      DateTime
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  shiftType ShiftType @relation(fields: [shiftTypeId], references: [id])
  shiftTypeId Int
  createdAt DateTime  @default(now())
}

model ShiftType {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String   // Store in HH:MM format
  endTime   String   // Store in HH:MM format
  createdAt DateTime @default(now())

  shiftAssignments ShiftAssignment[]
}

