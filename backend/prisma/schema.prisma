generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String?
  role             Role
  station          String
  active           Boolean           @default(true)
  shiftStart       DateTime?
  shiftEnd         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  schedules        Schedule[]
  shiftAssignments ShiftAssignment[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ShiftAssignment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  userId      Int
  shiftTypeId Int
  createdAt   DateTime  @default(now())
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model ShiftType {
  id               Int               @id @default(autoincrement())
  name             String
  startTime        String
  endTime          String
  createdAt        DateTime          @default(now())
  shiftAssignments ShiftAssignment[]
}

enum Role {
  admin
  dispatcher
  emt
}
