generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  dispatcher
  emt
}


model User {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  password         String? // Consider hashing on creation
  role             Role
  station          String
  active           Boolean           @default(true)
  shiftStart       DateTime? // Maybe later move to Schedule logic only
  shiftEnd         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  schedules        Schedule[]
  shiftAssignments ShiftAssignment[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model ShiftAssignment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  shiftTypeId Int
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  createdAt   DateTime  @default(now())
}

model ShiftType {
  id               Int               @id @default(autoincrement())
  name             String
  startTime        String // HH:MM format; could change to `DateTime` in future
  endTime          String
  createdAt        DateTime          @default(now())
  shiftAssignments ShiftAssignment[]
}
